def dfs_topologico(G, v, visitados, orden):

    visitados.add(v)

    for node in G[v]:
        if node not in visitados:
            dfs_topologico(G, node, visitados, orden)

    orden.append(v)


def orden_topologico(G):

    visitados = set()
    orden = []

    for v in G:
        if v not in visitados:
            dfs_topologico(G, v, visitados, orden)

    orden.reverse()

    return orden


def main():

    G = {
        0: [2, 3],
        1: [3, 4],
        2: [5],
        3: [5, 6],
        4: [6],
        5: [],
        6: []
    }

    resultado = orden_topologico(G)

    print("Orden topologico:", resultado)


if __name__ == "__main__":
    main()
