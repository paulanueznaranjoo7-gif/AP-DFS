
def dfs(G, v, visitados, recorrido): #mediante recursividad

    visitados.add(v)
    recorrido.append(v)
    
    for node in G[v]: #recorro los vertices actual de v
        #lo primero que hago en la funcion es marcar el vertice actual como visitado
        
        print(G[v][-1])
        
        if node not in visitados:
            dfs(G, node, visitados, recorrido)
            
            

        
        
        
    


