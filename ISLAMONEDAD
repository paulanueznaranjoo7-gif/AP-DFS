def recoger_tesoro(G, monedas, actual, visitados):

    visitados.add(actual)
    cantidad = monedas[actual]
    
    for isla in G[actual]:
        if isla not in visitados:
            cantidad += recoger_tesoro(G, monedas, isla, visitados)
            recoger_tesoro(G, monedas, isla, visitados)
    return cantidad

def main():

    islas = {
        0: [1, 3],
        1: [0, 2, 4],
        2: [1, 5],
        3: [0],
        4: [1],
        5: [2],
        6: []
    }

    monedas = {
        0: 10,
        1: 20,
        2: 5,
        3: 15,
        4: 30,
        5: 8,
        6: 50
    }

    visitados = set()

    total = recoger_tesoro(islas, monedas, 0, visitados)

    print("Monedas recogidas:", total)


if __name__ == "__main__":
    main()
